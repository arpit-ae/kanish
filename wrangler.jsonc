{
  "name": "kanish",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/documents/*",
      "/documents",
      "/upload",
      "/verify",
      "/documents.html",
      "/upload.html",
      "/verify.html",
      "/services",
      "/services/"
    ]
  },
  "vars": {
    "CASHFREE_ENV": "production",
    "SUPABASE_URL": "https://jpettksywgsptjnidhqw.supabase.co",
    "DOCS_SUPABASE_URL": "https://eamrwaqgbjrddhkzittb.supabase.co",
    "DOCS_SUPABASE_BUCKET": "private-documents",
    "DOCS_MAX_UPLOAD_BYTES": "10485760"
  },
  "d1_databases": [
    {
      "binding": "STORE_RECEIPTS",
      "database_name": "usoa-store-receipts",
      "database_id": "7d07571d-7538-4e9e-bdb1-ec51ec41e4ef"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
